# Set a stable random secret (at least 32 characters) for production.
BETTER_AUTH_SECRET=
# Full public origin, e.g. https://example.com
BETTER_AUTH_URL=http://127.0.0.1:3000
PORT=3000
# Required in production. Use credentials from your mail provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
